1000 '********************************
1010 '*BUTTLE GAME                   *
1020 '*Create by Komekichi 2026(1984)*
1030 '********************************
1040 GOSUB 2270 ' SET ARRAY
1050 GOSUB 2540 ' PRINT TITLE
1060 GOSUB 2040 ' DRAW BACKGROUND
1070 GOSUB 1110 ' MAIN
1080 GOTO 1050:END
1090 '************
1100 '*** MAIN ***
1110 '************
1120 A=RND(-TIME)
1130 SC=0:GOSUB 1510 :GOSUB 1580:GOSUB 1640 ' SCORE
1140 '*** KEY STRING SET
1150 K$="asdjkl":FOR I=0 TO 5:EK$(I)=MID$(K$,I+1,1):NEXT
1160 WC=300 ' WAIT TIME
1170 OPEN "GRP:" AS #1
1180 FOR I=0 TO 5
1190 LINE (KX(I),KY(I))-(KX(I)+7,KY(I)+7),1,BF
1200 PRESET (KX(I),KY(I)):PRINT #1,EK$(I)
1210 NEXT
1220 CLOSE #1
1230 SOUND 6, 0:SOUND 7, 56:SOUND 8, 0
1240 PLAY "T200 V15 O4 S1  M5000 L8 EEEEE2 F4F4 EEEEE2"
1250 IF PLAY(0) THEN GOTO 1250
1260 '*** MAIN LOOP ***
1270 LOOPFLG=0
1280 I=INT(RND(1)*6):IF I=J THEN GOTO 1280
1290 IF I=0 OR I=5 THEN PTS=10:PUT SPRITE 0,(EX(I),EY(I)),10,0
1300 IF I=1 OR I=4 THEN PTS=20:PUT SPRITE 0,(EX(I),EY(I)),15,1
1310 IF I=2 OR I=3 THEN PTS=30:PUT SPRITE 0,(EX(I),EY(I)),2,2
1320 J=I:IF WC<=10 THEN WC=10
1330 '*** KEY INPUT LOOP ***
1340 FOR W=0 TO WC
1350   A$=INKEY$
1360 ' *** SHOT SUCCESS ***
1370   IF A$=EK$(I) THEN GOSUB 1430:W=WC:WC=WC-10:LOOPFLG=1:GOTO 1380
1380 NEXT W
1390 '*** ENEMY ATTACK ***
1400 ES = RND(1) ' 10% CHANCE ENEMY WILL SHOOT
1410 IF LOOPFLG=0 AND ES < .1 THEN GOSUB 1770: GOSUB 1930:RETURN 'GAME OVER
1420 GOTO 1260
1430 ' *** SUB:SHOT SUCCESS ***
1440 PUT SPRITE 0,(EX(I),EY(I)),15,3
1450 GOSUB 1700  ' BOM! SOUND
1460 SC=SC+PTS ' ADD SCORE
1470 GOSUB 1580 ' PRINT SCORE
1480 IF SC>HSC THEN HSC=SC:GOSUB 1640 ' PRINT HIGH SCORE
1490 FOR K=0 TO 100:NEXT K
1500 RETURN
1510 ' *** SUB:PRINT HEAD ***
1520 OPEN "GRP:" AS #1
1530 LINE (3*8,0)-(34*8,7),1,BF
1540 PRESET (3*8,0):PRINT #1,"SCORE:"
1550 PRESET (16*8,0):PRINT #1,"HIGH SCORE:"
1560 CLOSE #1
1570 RETURN
1580 ' *** SUB:PRINT SCORE ***
1590 OPEN "GRP:" AS #1
1600 LINE (9*8,0)-(13*8,7),1,BF
1610 PRESET (9*8,0):PRINT #1,STR$(SC)
1620 CLOSE #1
1630 RETURN
1640 ' *** SUB:PRINT HIGH SCORE ***
1650 OPEN "GRP:" AS #1
1660 LINE (27*8,0)-(31*8,7),1,BF
1670 PRESET (27*8,0):PRINT #1,STR$(HSC)
1680 CLOSE #1
1690 RETURN
1700 ' *** SUB:BOM! SOUND ***
1710 SOUND 7,7:SOUND 8,15
1720 FOR I=1 TO 25
1730 SOUND 6,RND(1)*7+9
1740 NEXT I
1750 SOUND 8,0:SOUND 7,63
1760 RETURN
1770 ' *** SUB:FLUSH SCREEN ***
1780 SOUND 7,7:SOUND 8,15
1790 FOR I=1 TO 25
1800 SOUND 6,RND(1)*7+9
1810 NEXT I
1820 FOR I = 1 TO 10
1830 VDP(7)=6
1840 FOR T=1 TO 50:NEXT T
1850 VDP(7)=1
1860 FOR T=1 TO 50:NEXT T
1870 NEXT
1880 SOUND 8,0:SOUND 7,63
1890 RETURN
1900 '*****************
